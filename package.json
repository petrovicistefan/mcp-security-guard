{
  "name": "mcp-security-guard",
  "version": "0.9.2",
  "description": "MCP security scanner: audit installed MCP servers for tool poisoning, rug pulls, tool shadowing, prompt injection and supply-chain risk (OWASP MCP Top 10). Claude Code, Cursor.",
  "mcpName": "io.github.petrovicistefan/mcp-security-guard",
  "main": "plugin/dist/index.mjs",
  "bin": {
    "mcp-security-guard": "bin/mcp-security-guard.mjs"
  },
  "files": [
    "bin/",
    "plugin/dist/",
    "plugin/assets/logo.png",
    "LICENSE",
    "PRIVACY.md",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/build-app.mjs",
    "typecheck": "tsc --noEmit",
    "check:rules": "node scripts/check-rules.mjs",
    "prepublishOnly": "npm run typecheck && npm run check:rules && npm test && npm run build",
    "test": "vitest run",
    "bench": "npm run build && node bench/check.mjs",
    "sbom": "npm sbom --omit=dev --sbom-format cyclonedx > sbom.cdx.json",
    "dashboard:dev": "npm run build && node scripts/dashboard-harness.mjs",
    "demo": "node scripts/offline-demo.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/petrovicistefan/mcp-security-guard.git"
  },
  "author": "Stefan Petrovici",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/petrovicistefan/mcp-security-guard/issues"
  },
  "homepage": "https://github.com/petrovicistefan/mcp-security-guard#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@types/node": "26.6.4",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "mcp-security",
    "security",
    "security-scanner",
    "owasp",
    "owasp-mcp-top-10",
    "tool-poisoning",
    "tool-shadowing",
    "rug-pull",
    "prompt-injection",
    "supply-chain",
    "sarif",
    "audit",
    "local-first",
    "ai-agents",
    "claude",
    "claude-code",
    "cursor"
  ]
}
