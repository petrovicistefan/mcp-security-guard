{
  "name": "mcp-security",
  "version": "0.6.0",
  "description": "Security scanner for MCP servers in Claude Code: tool poisoning, shadowing, rug pulls and risky configuration.",
  "main": "dist/index.mjs",
  "scripts": {
    "build": "esbuild src/index.ts src/cli.ts src/hook.ts --bundle --platform=node --format=esm --target=node20 --outdir=dist --out-extension:.js=.mjs --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench": "npm run build && node bench/check.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/petrovicistefan/mcp-security.git"
  },
  "author": "Stefan Petrovici",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/petrovicistefan/mcp-security/issues"
  },
  "homepage": "https://github.com/petrovicistefan/mcp-security#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
